# Server-side email delivery for the feedback form
RESEND_API_KEY=re_your_api_key

# Optional. Defaults use Resend's test sender and the footer email address.
FEEDBACK_FROM_EMAIL=CVDPREVENT feedback <feedback@your-domain.example>
FEEDBACK_TO_EMAIL=eddie.davison@nhs.net

# Weekly catalog monitor. Generate a random value of at least 16 characters.
CRON_SECRET=replace_with_a_random_secret

# Added automatically when a private Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token
